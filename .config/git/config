    name = Raphaël Congiusti
    email = 122828688+racongiu@users.noreply.github.com

[core]
    # A wrapper, not `delta`: it picks the flavour at each call. git hands a
    # pager containing `~` to the shell, so it expands -- measured.
    pager = ~/.config/scripts/theme/delta.sh

[include]
    path = catppuccin.gitconfig

[delta]
    # Fallback only: the pager passes --features, which replaces this line.
    features = catppuccin-mocha
    side-by-side = true
    line-numbers = true
    # `n` and `N` jump from file to file inside the pager.
    navigate = true
    # The only one of the five file-header labels delta leaves empty.
    file-modified-label = modified:

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    # "editor" rather than the built-in "nvimdiff": the tool follows $EDITOR,
    # so changing the editor once moves diff and merge with it.
    tool = editor

[difftool]
    prompt = false

[difftool "editor"]
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$REMOTE\"

[merge]
    tool = editor
    conflictStyle = zdiff3

[mergetool "editor"]
    # LOCAL / BASE / REMOTE on top, MERGED (the one to save) below.
    cmd = \"$EDITOR\" -d \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\" -c '4wincmd w' -c 'wincmd J'
    # The exit code of an editor says nothing about the merge: git must ask.
    trustExitCode = false

[fetch]
    prune = true
    pruneTags = true
    all = true

[help]
    autocorrect = prompt

[commit]
    verbose = true

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[rerere]
    enabled = true
    autoupdate = true

[transfer]
    fsckObjects = true

[gpg]
    format = ssh

# gpg.ssh.* lives entirely in config.local: `program` differs per OS, and git
# expands no variable in pathname values, so allowedSignersFile has to be
# expanded at generation time.

# --- Per-forge identity ---
# The email above stays the DEFAULT, and it has to: a repository matching
# neither condition below must still have an email, or git refuses to commit.
# GitLab is an override, declared twice on purpose: one condition on the PATH,
# one on the REMOTE URL. What each one covers, and the blind spot they leave:
# README.md here.
# `hasconfig` needs git >= 2.36. The ~/lab path is written out because git
# expands no variable in a condition: move $REPOS and move this line too.
[includeIf "gitdir:~/lab/gitlab/"]
    path = config.gitlab
[includeIf "hasconfig:remote.*.url:git@gitlab.com:**/**"]
    path = config.gitlab

# Machine-local settings, generated by `./run install gitsign` and gitignored,
# so the same versioned config works on every machine. The path is relative to
# THIS file, and git ignores a missing include silently.
[include]
    path = config.local
